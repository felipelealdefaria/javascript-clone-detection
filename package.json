{
  "name": "javascript-clone-detection",
  "version": "1.0.0",
  "description": "AST-based code clone detector for JavaScript, TypeScript and React (JSX/TSX). Finds Type-1, Type-2 and Type-3 clones.",
  "license": "MIT",
  "author": "Luís Felipe Leal de Faria (https://github.com/felipelealdefaria)",
  "homepage": "https://github.com/felipelealdefaria/javascript-clone-detection#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipelealdefaria/javascript-clone-detection.git"
  },
  "bugs": {
    "url": "https://github.com/felipelealdefaria/javascript-clone-detection/issues"
  },
  "keywords": [
    "clone-detection",
    "code-duplication",
    "copy-paste",
    "ast",
    "javascript",
    "typescript",
    "react",
    "jsx",
    "sarif",
    "static-analysis"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "jscd": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx benchmark/run.ts",
    "bench:embeddings": "tsx benchmark/run.ts --embeddings",
    "playground": "vite playground",
    "playground:build": "vite build playground",
    "prepublishOnly": "npm run build",
    "study": "tsx study/run.ts"
  },
  "dependencies": {
    "@babel/generator": "8.0.6",
    "@babel/parser": "8.0.8",
    "@babel/types": "8.0.8",
    "tinyglobby": "0.2.17"
  },
  "devDependencies": {
    "@babel/traverse": "8.0.7",
    "@biomejs/biome": "2.6.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@huggingface/transformers": "4.3.2",
    "@lezer/highlight": "1.2.5",
    "@types/node": "26.6.5",
    "codemirror": "6.0.2",
    "jscpd": "5.4.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
